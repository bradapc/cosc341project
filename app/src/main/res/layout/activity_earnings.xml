<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@color/white"
            android:elevation="4dp">

            <TextView
                android:id="@+id/earningsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EARNINGS"
                android:textColor="@color/primary_green"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- WORKER: Earnings Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/workerEarningsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTIMATED DAILY EARNINGS"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/estimatedEarningsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/earningsBreakdownText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hourly: $0.00 | Bins: $0.00"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- MANAGER: Payroll Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/managerPayrollCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTIMATED TOTAL PAYROLL (TODAY)"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/totalPayrollText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_orange"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/payrollBreakdownText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Base Wages: $0.00 | Bonuses: $0.00"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Stats Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/statsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/statsCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SHIFT PRODUCTION"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/binsLabelText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Bins Harvested"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/totalBinsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="0 Bins"
                                android:textStyle="bold"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"/>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/efficiencyLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Labor Cost per Bin"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/avgCostPerBinText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="$0.00"
                                android:textStyle="bold"
                                android:textColor="@color/accent_orange"
                                android:textSize="16sp"/>
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/viewShiftDetailsButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="VIEW SHIFT DETAILS"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary_light"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"/>

                <Button
                    android:id="@+id/managerReviewLogsButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="REVIEW ALL LOGS"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary_green"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    android:visibility="gone"/>

                <!-- No Active Shift Message -->
                <TextView
                    android:id="@+id/noActiveShiftEarningsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No active shift. Data shown is from your last recorded session."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/primary_green"
        app:itemTextColor="@color/primary_green"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>