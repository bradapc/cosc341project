<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT SHIFT LOG"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:layout_marginBottom="24dp"/>

        <!-- Shift Times -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clock In Time (HH:mm)"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/editClockInTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 08:30"
            android:inputType="time"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clock Out Time (HH:mm)"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/editClockOutTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 16:45"
            android:inputType="time"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="24dp"/>

        <!-- Fruit Bins Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIN COUNTS BY FRUIT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/fruitBinsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <!-- Programmatically filled with fruit name + EditText rows -->
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manager Notes"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reason for adjustment..."
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Updates will mark this shift as 'Manager Verified'."
            android:textSize="12sp"
            android:textColor="@color/accent_orange"
            android:textStyle="italic"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>