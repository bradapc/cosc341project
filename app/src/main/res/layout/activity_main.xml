<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@color/white"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORCHARD MS"
                android:textColor="@color/primary_green"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <ImageButton
                android:id="@+id/profileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/text_secondary"
                android:contentDescription="Profile" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textColor="@color/text_main"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- WORKER: Status Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/workerStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT STATUS"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not clocked in"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main"
                            android:layout_marginBottom="20dp"/>

                        <Button
                            android:id="@+id/clockInButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="Clock In"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary_green"
                            android:textColor="@color/white"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- MANAGER: Overview Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/managerOverviewCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FARM OVERVIEW (TODAY)"
                            android:textSize="12sp"
                            android:textColor="@color/primary_green"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/totalFarmBinsText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_main"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Bins"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/activeWorkersCountText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_main"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Active Workers"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- MANAGER: Quick Actions -->
                <LinearLayout
                    android:id="@+id/managerQuickActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/mainDashboardButton"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:text="VIEW DASHBOARD"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_green"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/mainReviewButton"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:text="REVIEW LOGS"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary_light"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="24dp"/>
                </LinearLayout>

                <!-- WORKER: Big Log Harvest Button -->
                <Button
                    android:id="@+id/mainLogHarvestButton"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:text="LOG HARVEST"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/status_clocked_in"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="24dp"
                    android:elevation="4dp"
                    android:visibility="gone"/>

                <!-- WORKER: Active Shift Stats Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/activeShiftCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="#E8F5E9">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE SHIFT STATS"
                            android:textSize="12sp"
                            android:textColor="@color/primary_green"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Duration"
                                android:textColor="@color/text_secondary"/>
                            <TextView
                                android:id="@+id/shiftDurationText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="0h 0m"
                                android:textStyle="bold"
                                android:textColor="@color/primary_green"/>
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bins Harvested"
                                android:textColor="@color/text_secondary"/>
                            <TextView
                                android:id="@+id/binsHarvestedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="0 Bins"
                                android:textStyle="bold"
                                android:textColor="@color/primary_green"/>
                        </RelativeLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- MANAGER: Harvest Breakdown Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/managerCropsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HARVEST BY CROP (TODAY)"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/cropBreakdownText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No harvest logs yet today."
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- WORKER: Schedule Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/scheduleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TODAY'S SCHEDULE"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="16dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shift"
                                android:textColor="@color/text_secondary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="10:00 AM - 4:00 PM"
                                android:textStyle="bold"
                                android:textColor="@color/text_main"/>
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zone"
                                android:textColor="@color/text_secondary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Apple Orchard - Row B"
                                android:textStyle="bold"
                                android:textColor="@color/text_main"/>
                        </RelativeLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/primary_green"
        app:itemTextColor="@color/primary_green"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>