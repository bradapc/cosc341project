<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header - Increased margin for camera hole punch consistency -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@color/white"
            android:elevation="4dp"
            android:layout_marginTop="48dp">

            <TextView
                android:id="@+id/headerWorkerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Worker Name"
                android:textColor="@color/primary_green"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Time Details -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/detailClockIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clock In: --"
                            android:textSize="16sp"
                            android:textColor="@color/text_main"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/detailClockOut"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clock Out: --"
                            android:textSize="16sp"
                            android:textColor="@color/text_main"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/detailTotalTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Time: 0h 0m"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Harvest Breakdown -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HARVEST BREAKDOWN"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/harvestBreakdownText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Loading..."
                            android:textSize="16sp"
                            android:textColor="@color/text_main"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/averageRateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average Rate: 0.0 Bins/hr"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_orange"
                            android:layout_marginBottom="24dp"/>

                        <Button
                            android:id="@+id/editLogButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="EDIT SHIFT LOG"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/white"
                            android:textColor="@color/text_secondary"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/text_secondary"
                            app:strokeWidth="1dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- MANAGER REVIEW: Estimated Earnings Section -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/reviewEarningsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="32dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="#E8F5E9">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WORKER ESTIMATED EARNINGS"
                            android:textSize="12sp"
                            android:textColor="@color/primary_green"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/reviewEstimatedEarnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/reviewEarningsBreakdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hourly: $0.00 | Bins: $0.00"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="8dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="BACK"
                android:backgroundTint="@color/white"
                android:textColor="@color/text_secondary"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <Button
                android:id="@+id/approveButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1.5"
                android:text="APPROVE WORK"
                android:backgroundTint="@color/primary_green"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>