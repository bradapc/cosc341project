<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_light"
    tools:context=".ShiftDetailsActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SHIFT DETAILS"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/detailWorkerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Worker: --"
                android:textSize="18sp"
                android:textColor="@color/text_main"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/detailZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned Zone: --"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/detailStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Time: --"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/detailEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Time: --"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/detailDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Time on Shift: --"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Earnings Breakdown (Only visible when not clocked in) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/detailEarningsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#E8F5E9">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION EARNINGS"
                android:textSize="12sp"
                android:textColor="@color/primary_green"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/detailEstimatedEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/detailEarningsBreakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hourly: $0.00 | Bins: $0.00"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/backToEarningsButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="BACK TO EARNINGS"
        android:backgroundTint="@color/white"
        android:textColor="@color/text_secondary"
        app:cornerRadius="12dp"
        app:strokeColor="@color/text_secondary"
        app:strokeWidth="1dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

</LinearLayout>