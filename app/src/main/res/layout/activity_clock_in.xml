<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".ClockInActivity"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ORMS - Orchard Management Software"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you ready to Clock in?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/timeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time: --:-- --"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="12dp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Worker: Fahar Murray"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zone: Apple Orchard - Row B"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/confirmClockInButton"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:text="Clock In"
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#E0E0E0"
        android:textColor="#000000"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:text="Cancel"
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#E0E0E0"
        android:textColor="#000000"
        app:cornerRadius="12dp"/>

</LinearLayout>